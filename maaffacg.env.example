# 将本文件复制为 maaffacg.env 后编辑。请勿提交包含个人配置的 maaffacg.env。

# ADB 可执行文件路径。启动脚本会优先使用此设置；留空时使用自带 platform-tools 中的 adb.exe。
MAAFFACG_ADB=.\platform-tools\adb.exe

# 下载的 MaaFramework 项目通过 StartApp 动作发送的 Android 包名。
MAAFFACG_PACKAGE=com.example.game

# 对应的网易云游戏 code，由用户自行填写。
MAAFFACG_GAME_CODE=mrfz

# 可选设置。
MAAFFACG_PORT=5555
MAAFFACG_RECONNECT_INTERVAL=0.25
MAAFFACG_WIDTH=1920
MAAFFACG_HEIGHT=1080
MAAFFACG_PROFILE=.maaffacg-profile
MAAFFACG_CLOUD_URL=https://cg.163.com

# 可选。启动MaaEnd.bat 会使用此路径启动 MaaEnd，并将自带 adb.exe 放入 PATH，
# 使 MaaFramework Toolkit 能扫描到 MaaFFACG。
MAAFFACG_MAAEND_EXE=C:\Users\Administrator\Downloads\MaaEnd-win-x86_64-v2.19.0\MaaEnd.exe

# 启动MaaFW项目.bat 的可选目标程序。也可直接将 .exe 拖到该脚本上。
# 目标程序会继承 PATH 中 MaaFFACG 自带的 adb.exe。
# MAAFFACG_TARGET_EXE=C:\path\to\another-maafw-project\Project.exe

# 可选的额外映射，多个映射以逗号分隔：Android包名=网易云游戏code。
# MAAFFACG_ROUTES=com.example.other=another_game

# 可选的截图颜色增强；全部为 1.0 时不处理原始 PNG。
# MAAFFACG_ENHANCE_SATURATION=1.0
# MAAFFACG_ENHANCE_CONTRAST=1.0
# MAAFFACG_ENHANCE_BRIGHTNESS=1.0
